<script>
const icons={dashboard:'<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',study:'<circle cx="12" cy="13" r="8"/><path d="M12 9v5l3 2M9 2h6"/>',groups:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3.1a4 4 0 0 1 0 7.8M22 21v-2a4 4 0 0 0-3-3.9"/><circle cx="9" cy="7" r="4"/>',modules:'<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>',goals:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',history:'<path d="M3 12a9 9 0 1 0 3-7M3 3v5h5M12 7v5l4 2"/>',chart:'<path d="M3 3v18h18M7 17v-5M12 17V7M17 17v-8"/>',flame:'<path d="M12 22c5 0 8-4 8-9 0-4-2-6-4-8-.4 3-2.5 4-3 5-1-4-3-7-6-8 0 4-3 7-3 12 0 5 3 8 8 8Z"/>',plus:'<path d="M12 5v14M5 12h14"/>',arrow:'<path d="M5 12h14m-6-6 6 6-6 6"/>',pause:'<rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/>',play:'<path d="m7 4 13 8-13 8z"/>',stop:'<rect x="5" y="5" width="14" height="14" rx="2"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/>',archive:'<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v12h14V8M10 12h4"/>',trophy:'<path d="M8 21h8M12 17v4M7 4h10v7a5 5 0 0 1-10 0V4ZM7 6H3v3a4 4 0 0 0 4 4m10-7h4v3a4 4 0 0 1-4 4"/>',check:'<path d="m4 12 5 5L20 6"/>',users:'<circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6m4 9v-2a5 5 0 0 0-4-5"/>'};
const icon=(k)=>`<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[k]||icons.study}</svg>`;
const seed=()=>({modules:[{id:'m1',code:'COMP304',name:'Artificial Intelligence',period:'Semester 2 · 2026',minutes:2520,color:'#6b61ed',archived:false},{id:'m2',code:'COMP314',name:'Theory of Computation',period:'Semester 2 · 2026',minutes:1935,color:'#26af91',archived:false},{id:'m3',code:'ISTN3SI',name:'Internet Programming',period:'Semester 2 · 2026',minutes:1370,color:'#e8a251',archived:false},{id:'m4',code:'ISTN3ND',name:'Business Data Communications',period:'Semester 2 · 2026',minutes:820,color:'#ee85a2',archived:false}],groups:[{id:'g1',name:'COMP304 Exam Prep',module:'COMP304',members:12,ends:'Ends in 4 days',joined:true,minutes:425},{id:'g2',name:'Theory of Computation Squad',module:'COMP314',members:8,ends:'Ends in 2 days',joined:true,minutes:260},{id:'g3',name:'Web Dev Focus Week',module:'ISTN3SI',members:17,ends:'Ends in 6 days',joined:false,minutes:0}],history:[{id:'h1',date:'2026-11-04',module:'COMP304',minutes:85,type:'Stopwatch',group:'COMP304 Exam Prep'},{id:'h2',date:'2026-11-03',module:'COMP314',minutes:120,type:'Countdown',group:''},{id:'h3',date:'2026-11-02',module:'ISTN3SI',minutes:60,type:'Manual',group:''},{id:'h4',date:'2026-11-01',module:'COMP304',minutes:150,type:'Stopwatch',group:'COMP304 Exam Prep'}],goal:180,streakMin:45,streak:12,weekly:[110,95,185,135,145,170,85],timer:{mode:'stopwatch',module:'m1',group:'personal',elapsed:0,remaining:1500,running:false,lastTick:0},active:'dashboard'});
let state;try{state=JSON.parse(localStorage.getItem('studysync_demo_v2'))||seed()}catch(e){state=seed()}let section=state.active||'dashboard',groupTab='my',moduleTab='active',historyTab='all';let initialTimer=false;const save=()=>{try{localStorage.setItem('studysync_demo_v2',JSON.stringify({...state,active:section}))}catch(e){}};
const nav=[['dashboard','Overview','dashboard'],['study','Study Timer','study'],['groups','Study Groups','groups'],['modules','My Modules','modules'],['goals','Goals & Streaks','goals'],['history','Study History','history']];
const fmt=m=>{let a=Math.floor(m/60),b=Math.floor(m%60);return a?`${a}h ${b?b+'m':''}`.trim():`${b}m`};const clock=s=>`${String(Math.floor(Math.abs(s)/3600)).padStart(2,'0')}:${String(Math.floor(Math.abs(s)%3600/60)).padStart(2,'0')}:${String(Math.floor(Math.abs(s)%60)).padStart(2,'0')}`;const safe=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function tick(){const t=state.timer;if(t.running){let now=Date.now(),delta=Math.max(0,Math.floor((now-t.lastTick)/1000));if(delta>0){t.lastTick+=delta*1000;if(t.mode==='stopwatch')t.elapsed+=delta;else{t.remaining=Math.max(0,t.remaining-delta);if(t.remaining===0){t.running=false;toast('Countdown completed! Save your study session.')}}save()}}if(section==='study')updateTimerDisplay()}
function updateTimerDisplay(){let t=state.timer,c=document.getElementById('timerClock');if(!c)return;c.textContent=clock(t.mode==='stopwatch'?t.elapsed:t.remaining);let ring=document.getElementById('timerRing');if(ring)ring.style.setProperty('--pct',`${t.mode==='stopwatch'?Math.min(t.elapsed/3600*100,100):Math.min((1-t.remaining/(t.planned||1500))*100,100)}%`);let st=document.getElementById('timerStatus');if(st)st.textContent=t.running?'● Timer is running':(t.elapsed>0||t.remaining<(t.planned||1500))?'● Paused — your progress is saved':'● Ready when you are'};setInterval(tick,500);
