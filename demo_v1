const head=(eye,title,desc,button='')=>`<div class="pagehead"><div><div class="eyebrow">${eye}</div><h1>${title}</h1><p>${desc}</p></div>${button}</div>`;
const title=(name,link='',action='')=>`<div class="card-title"><h3>${name}</h3>${link?`<a data-go="${action}">${link} →</a>`:''}</div>`;
const progress=(value,total,color='')=>`<div class="progress ${color}"><div style="width:${Math.max(0,Math.min(100,value/Math.max(total,1)*100))}%"></div></div>`;
const stat=(ic,label,value,hint,bg='#f0efff',fg='#635cf4')=>`<div class="card stat"><div class="stat-icon" style="background:${bg};color:${fg}">${icon(ic)}</div><small>${label}</small><strong>${value}</strong><span class="hint">${hint}</span></div>`;
function renderNav(){for(let id of ['desktopNav','mobileNav'])document.getElementById(id).innerHTML=nav.map(([key,label,ic])=>`<button data-go="${key}" class="${id==='desktopNav'?'nav-item':''} ${section===key?'active':''}">${icon(ic)}<span>${label}</span></button>`).join('');document.getElementById('crumb').textContent=nav.find(x=>x[0]===section)?.[1]||'Overview'}
function dashboard(){let total=state.modules.reduce((a,m)=>a+m.minutes,0)+state.history.filter(h=>h.added).reduce((a,h)=>a+h.minutes,0),day=state.history.filter(h=>h.date==='2026-11-04').reduce((a,h)=>a+h.minutes,0);return head('YOUR STUDY SPACE','Good morning, Siyathemba 👋','Here’s your study progress at a glance.',`<button class="btn" data-go="study">${icon('plus')} Start studying</button>`)+`<div class="stats">${stat('clock','Total study time',fmt(total),'+ 8.5% from last week')}${stat('study','Today’s focus',fmt(day),'Keep the momentum going','#eaf8f3','#1ca985')}${stat('flame','Current streak',state.streak+' days','🔥 Your consistency matters','#fff4e9','#e69b42')}${stat('users','Active study groups',state.groups.filter(g=>g.joined).length,'Study better together','#edf2ff','#5e83d8')}</div><div class="dashboard-grid"><div style="display:flex;flex-direction:column;gap:20px"><div class="card">${title('Study activity this week','View history','history')}<div class="chart-bars">${state.weekly.map((n,i)=>`<div class="bar-wrap"><div class="bar ${i===6?'current':''}" data-label="${fmt(n)}" style="height:${Math.max(5,n/210*100)}%"></div></div>`).join('')}</div><div class="xlabels">${['Thu','Fri','Sat','Sun','Mon','Tue','Wed'].map(x=>`<span>${x}</span>`).join('')}</div><div style="display:flex;gap:18px;margin-top:23px;font-size:12px;color:var(--muted)"><span>● <b style="color:var(--text)">15h 25m</b> this week</span><span>● <b style="color:var(--text)">2h 12m</b> daily average</span></div></div><div class="card">${title('Your modules','Manage modules','modules')}${state.modules.filter(m=>!m.archived).slice(0,4).map(m=>`<div class="list-row"><div class="module-symbol" style="background:${m.color}17;color:${m.color}">${safe(m.code.slice(0,2))}</div><div class="row-main"><strong>${safe(m.code)}</strong><small>${safe(m.name)}</small></div><div class="row-right"><strong>${fmt(m.minutes)}</strong><small>Total studied</small></div></div>`).join('')}</div></div><div style="display:flex;flex-direction:column;gap:20px"><div class="card study-card"><div class="eyebrow">FOCUS MODE</div><h3>Ready for your next<br>study session?</h3><p>Set a timer, choose your module, and make every minute count.</p><button class="btn" data-go="study">${icon('play')} Start focus session</button></div><div class="card">${title('Your study goals','View all','goals')}<div class="goal"><div class="progress-header"><span>Daily goal</span><span>${fmt(day)} / ${fmt(state.goal)}</span></div>${progress(day,state.goal)}</div><div class="goal"><div class="progress-header"><span>Weekly goal</span><span>15h 25m / 20h</span></div>${progress(925,1200,'mint')}</div><div class="goal"><div class="progress-header"><span>Monthly goal</span><span>41h 20m / 60h</span></div>${progress(2480,3600,'orange')}</div></div><div class="card">${title('Group snapshot','All groups','groups')}${state.groups.filter(g=>g.joined).slice(0,2).map(g=>`<div class="list-row"><div class="module-symbol" style="background:#f0efff;color:#655ce9">${icon('users')}</div><div class="row-main"><strong>${safe(g.name)}</strong><small>${g.members} participants · ${g.ends}</small></div><span class="pill">Active</span></div>`).join('')}</div></div></div>`}
function study(){let t=state.timer,mods=state.modules.filter(m=>!m.archived),groupOptions=state.groups.filter(g=>g.joined).map(g=>`<option value="${g.id}" ${t.group===g.id?'selected':''}>${safe(g.name)}</option>`).join('');return head('FOCUS & PRODUCTIVITY','Study Timer','Track your focus with a stopwatch or countdown timer.',`<button class="btn secondary" id="manualBtn">${icon('plus')} Add manual time</button>`)+`<div class="split"><div class="card"><div class="toggle-row"><button class="chip ${t.mode==='stopwatch'?'selected':''}" data-timer-mode="stopwatch">Stopwatch</button><button class="chip ${t.mode==='countdown'?'selected':''}" data-timer-mode="countdown">Countdown</button></div><div class="timer-box"><div class="timer-ring" id="timerRing"><div class="timer-inner"><div style="color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px">Focus session</div><div class="timer-clock" id="timerClock">${clock(t.mode==='stopwatch'?t.elapsed:t.remaining)}</div><div class="timer-status" id="timerStatus"></div></div></div><div class="timer-controls">${t.running?`<button class="btn" id="pauseTimer">${icon('pause')} Pause</button>`:`<button class="btn" id="startTimer">${icon('play')} ${t.elapsed>0||t.remaining<(t.planned||1500)?'Resume':'Start'} focus</button>`}<button class="btn secondary" id="saveTimer" ${(!t.elapsed&&t.remaining===(t.planned||1500))?'disabled':''}>${icon('check')} Finish & save</button><button class="btn secondary" id="resetTimer">Reset</button></div></div></div><div><div class="card" style="margin-bottom:20px">${title('Session settings')}<div class="field"><label>Academic module</label><select id="timerModule" ${t.running?'disabled':''}>${mods.map(m=>`<option value="${m.id}" ${m.id===t.module?'selected':''}>${safe(m.code)} — ${safe(m.name)}</option>`).join('')}</select></div><div class="field"><label>Study type</label><select id="timerGroup" ${t.running?'disabled':''}><option value="personal" ${t.group==='personal'?'selected':''}>Personal study</option>${groupOptions}</select></div>${t.mode==='countdown'?`<div class="field"><label>Focus duration (minutes)</label><input id="timerDuration" type="number" min="1" max="720" value="${Math.floor((t.planned||1500)/60)}" ${t.running?'disabled':''}></div>`:''}<div class="panel-note">Only one study timer can run at a time. Group time counts toward your personal totals and that group's leaderboard—never twice.</div></div><div class="card">${title('Focus tips')}<div class="list-row"><div class="stat-icon" style="background:#f0efff;color:var(--primary);margin:0">${icon('clock')}</div><div class="row-main"><strong>Stay consistent</strong><small>Short, focused sessions add up.</small></div></div><div class="list-row"><div class="stat-icon" style="background:#e8f8f2;color:var(--mint);margin:0">${icon('check')}</div><div class="row-main"><strong>Your progress is kept</strong><small>Pause and resume whenever you need.</small></div></div></div></div></div>`}
function groups(){let list=state.groups.filter(g=>groupTab==='my'?g.joined:!g.joined);return head('STUDY TOGETHER','Collaborative Study Groups','Join a study circle, compare progress, and motivate each other.',`<button class="btn" id="createGroup">${icon('plus')} Create group</button>`)+`<div class="tabbar"><button class="chip ${groupTab==='my'?'selected':''}" data-group-tab="my">My groups</button><button class="chip ${groupTab==='discover'?'selected':''}" data-group-tab="discover">Discover groups</button></div><div class="dashboard-grid"><div class="group-grid">${list.map((g,i)=>`<div class="card group-card"><div class="cover"><span class="pill purple">${safe(g.module)}</span>${icon('users')}</div><h3>${safe(g.name)}</h3><p>${icon('users')} ${g.members} members &nbsp; · &nbsp; ${safe(g.ends)}</p><div class="group-footer"><div class="avatars"><span>AM</span><span>NT</span><span>SK</span><span>+${Math.max(0,g.members-3)}</span></div><button class="btn ${g.joined?'secondary':''}" data-group-action="${g.id}">${g.joined?'View group':'Join group'} ${icon('arrow')}</button></div></div>`).join('')||'<div class="empty">No groups in this section yet.</div>'}</div><div class="card">${title('Top study contributors')}<div class="panel-note" style="margin-bottom:10px">Example leaderboard · COMP304 Exam Prep</div>${[['1','Anele M.','14h 30m'],['2','Siyathemba M.','12h 15m'],['3','Thando N.','10h 50m'],['4','Lerato P.','8h 20m']].map(([rank,name,time])=>`<div class="leader-row"><div class="rank ${rank==='1'?'top':''}">${rank==='1'?'🏆':rank}</div><div class="avatar" style="width:31px;height:31px;font-size:10px">${name.split(' ').map(s=>s[0]).join('')}</div><div class="leader-name"><strong>${name}</strong><small>${rank==='2'?'You · Keep going!':'Study contributor'}</small></div><div class="leader-hours">${time}</div></div>`).join('')}<div class="panel-note" style="margin-top:16px">Group credit comes from group timers only. Manually entered personal study time does not affect rankings.</div></div></div>`}
function modules(){const a=state.modules.filter(m=>moduleTab==='archived'?m.archived:!m.archived);return head('STAY ORGANISED','My Academic Modules','Keep every subject and academic attempt in one place.',`<button class="btn" id="addModule">${icon('plus')} Add module</button>`)+`<div class="tabbar"><button class="chip ${moduleTab==='active'?'selected':''}" data-module-tab="active">Active modules (${state.modules.filter(m=>!m.archived).length})</button><button class="chip ${moduleTab==='archived'?'selected':''}" data-module-tab="archived">Archived (${state.modules.filter(m=>m.archived).length})</button></div><div class="card">${title(moduleTab==='active'?'Your current modules':'Archived modules')}${a.length?a.map(m=>`<div class="list-row"><div class="module-symbol" style="background:${m.color}19;color:${m.color}">${safe(m.code.slice(0,2))}</div><div class="row-main"><strong>${safe(m.code)} · ${safe(m.name)}</strong><small>${safe(m.period)} · ${fmt(m.minutes)} studied</small></div><button class="btn secondary" data-archive="${m.id}">${icon('archive')} ${m.archived?'Restore':'Archive'}</button></div>`).join(''):'<div class="empty">Nothing here yet. Your modules will appear in this section.</div>'}</div><div class="card" style="margin-top:20px"><div class="card-title"><h3>Why archive?</h3></div><p class="panel-note">Archived modules leave your active study list, but all their recorded hours, history and statistics stay with your account. You can restore them whenever you need.</p></div>`}
function goals(){let day=state.history.filter(h=>h.date==='2026-11-04').reduce((a,h)=>a+h.minutes,0);return head('KEEP THE STREAK ALIVE','Goals & Streaks','Build consistent habits, one study day at a time.',`<button class="btn secondary" id="editGoals">${icon('goals')} Edit goals</button>`)+`<div class="stats" style="grid-template-columns:repeat(3,minmax(0,1fr))">${stat('flame','Current streak',state.streak+' days','Nice work!','#fff3e7','#db963f')}${stat('trophy','Longest streak','18 days','Your personal best','#f0efff','#665ce9')}${stat('clock','Daily minimum',fmt(state.streakMin),'To maintain your streak','#e6f8f1','#24ac8c')}</div><div class="split"><div class="card">${title('Your progress')}<div class="goal"><div class="progress-header"><span>Daily focus goal</span><span>${fmt(day)} of ${fmt(state.goal)}</span></div>${progress(day,state.goal)}<p class="panel-note">${Math.round(day/state.goal*100)}% complete</p></div><div class="goal"><div class="progress-header"><span>Weekly study goal</span><span>15h 25m of 20h</span></div>${progress(925,1200,'mint')}</div><div class="goal"><div class="progress-header"><span>Monthly study goal</span><span>41h 20m of 60h</span></div>${progress(2480,3600,'orange')}</div></div><div class="card">${title('Consistency calendar')}<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:7px;text-align:center">${['M','T','W','T','F','S','S'].map(x=>`<span style="font-size:11px;color:var(--muted);font-weight:800">${x}</span>`).join('')}${Array.from({length:28},(_,i)=>`<div title="${i+1} November" style="aspect-ratio:1;display:grid;place-items:center;border-radius:7px;background:${i<4?'#d7d2ff':i<17?(i%7===5?'#f0f1f6':'#a6e5d2'):'#f3f5f9'};color:${i<17?'#4f48a7':'#9da7b8'};font-size:11px;font-weight:800">${i+1}</div>`).join('')}</div><p class="panel-note" style="margin-bottom:0;margin-top:18px">A day counts toward your streak when your combined valid personal and timed study duration meets your daily minimum.</p></div></div>`}
function history(){let records=state.history.filter(h=>historyTab==='all'||(historyTab==='manual'?h.type==='Manual':h.group));return head('YOUR EFFORT, RECORDED','Study History','Review every session, including your manual study entries.',`<button class="btn secondary" id="manualBtn">${icon('plus')} Add manual time</button>`)+`<div class="tabbar"><button class="chip ${historyTab==='all'?'selected':''}" data-history-tab="all">All activities</button><button class="chip ${historyTab==='manual'?'selected':''}" data-history-tab="manual">Manual</button><button class="chip ${historyTab==='group'?'selected':''}" data-history-tab="group">Group sessions</button></div><div class="card table-wrap"><table class="table"><thead><tr><th>Date</th><th>Module</th><th>Duration</th><th>Method</th><th>Associated session</th></tr></thead><tbody>${records.map(h=>`<tr><td>${safe(h.date)}</td><td><strong>${safe(h.module)}</strong></td><td><strong>${fmt(h.minutes)}</strong></td><td><span class="pill ${h.type==='Manual'?'orange':'purple'}">${safe(h.type)}</span></td><td style="color:var(--muted)">${safe(h.group||'Personal study')}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No study activities match this filter.</td></tr>'}</tbody></table></div><div class="card" style="margin-top:20px"><p class="panel-note" style="margin:0">Your real StudySync app will keep detailed timestamps, pause and resume periods, corrections, and recovery history. This prototype displays a simplified view.</p></div>`}
function render(){renderNav();document.getElementById('view').innerHTML=({dashboard,study,groups,modules,goals,history}[section]||dashboard)();if(section==='study')updateTimerDisplay();save()}
function go(s){section=s;window.scrollTo({top:0,behavior:'smooth'});render()}
function openModal(titleText,sub,body){document.getElementById('modalTitle').textContent=titleText;document.getElementById('modalSub').textContent=sub;document.getElementById('modalBody').innerHTML=body;document.getElementById('modalBack').classList.add('open')}
function closeModal(){document.getElementById('modalBack').classList.remove('open')}
function manualModal(){openModal('Add manual study time','For personal studying only — never counted on group leaderboards.',`<form id="manualForm"><div class="field"><label>Personal module</label><select name="module" required>${state.modules.filter(m=>!m.archived).map(m=>`<option value="${m.id}">${safe(m.code)} — ${safe(m.name)}</option>`).join('')}</select></div><div class="field"><label>Study date</label><input name="date" type="date" value="2026-11-04" max="${new Date().toISOString().slice(0,10)}" required></div><div class="field-row"><div class="field"><label>Hours</label><input name="hours" type="number" min="0" max="23" value="1" required></div><div class="field"><label>Minutes</label><input name="minutes" type="number" min="0" max="59" value="0" required></div></div><div class="field"><label>Notes (optional)</label><textarea name="notes" placeholder="What did you study?"></textarea></div><button class="btn" style="width:100%">${icon('check')} Add to personal history</button></form>`) }
function addModuleModal(){openModal('Add academic module','Track a new subject or a different academic attempt.',`<form id="moduleForm"><div class="field"><label>Module code</label><input name="code" placeholder="e.g. COMP304" maxlength="30" required></div><div class="field"><label>Module name</label><input name="name" placeholder="e.g. Artificial Intelligence" maxlength="80" required></div><div class="field-row"><div class="field"><label>Academic year (optional)</label><input name="year" type="number" min="2000" max="2100" placeholder="2027"></div><div class="field"><label>Semester (optional)</label><select name="semester"><option value="">Not specified</option><option>Semester 1</option><option>Semester 2</option><option>Full year</option></select></div></div><button class="btn" style="width:100%">${icon('plus')} Add module</button></form>`) }
function createGroupModal(){openModal('Create study group','Start a collaborative study session with classmates.',`<form id="groupForm"><div class="field"><label>Group name</label><input name="name" placeholder="e.g. Database Exam Prep" maxlength="70" required></div><div class="field"><label>Associated module</label><select name="module">${state.modules.filter(m=>!m.archived).map(m=>`<option value="${safe(m.code)}">${safe(m.code)}</option>`).join('')}</select></div><div class="field-row"><div class="field"><label>Duration (days)</label><input name="days" type="number" min="1" max="365" value="7" required></div><div class="field"><label>Join settings</label><select name="access"><option value="approval">Creator approval</option><option value="auto">Auto-join</option></select></div></div><p class="panel-note">This prototype creates a sample group locally in your browser; it does not invite real people.</p><button class="btn" style="width:100%">${icon('plus')} Create group</button></form>`) }
function editGoalsModal(){openModal('Edit study goals','Set goals that match your own study routine.',`<form id="goalForm"><div class="field"><label>Daily goal (minutes)</label><input name="goal" type="number" min="1" max="1440" value="${state.goal}" required></div><div class="field"><label>Daily streak minimum (minutes)</label><input name="streak" type="number" min="1" max="1440" value="${state.streakMin}" required></div><p class="panel-note">In the full app, changes to the streak minimum apply starting the next calendar day.</p><button class="btn" style="width:100%">Save goal settings</button></form>`) }
function handleClick(e){let el=e.target.closest('[data-go],[data-timer-mode],[data-group-tab],[data-module-tab],[data-history-tab],[data-archive],[data-group-action],#startTimer,#pauseTimer,#saveTimer,#resetTimer,#manualBtn,#addModule,#createGroup,#editGoals,#reset,#closeModal');if(!el)return;if(el.dataset.go){go(el.dataset.go);return}if(el.dataset.timerMode){if(state.timer.running){toast('Pause your timer before switching mode.');return}let mode=el.dataset.timerMode;state.timer.mode=mode;state.timer.elapsed=0;state.timer.remaining=state.timer.planned||1500;render();return}if(el.dataset.groupTab){groupTab=el.dataset.groupTab;render();return}if(el.dataset.moduleTab){moduleTab=el.dataset.moduleTab;render();return}if(el.dataset.historyTab){historyTab=el.dataset.historyTab;render();return}if(el.dataset.archive){let m=state.modules.find(x=>x.id===el.dataset.archive);if(m){if(state.timer.module===m.id&&state.timer.running){toast('Finish your current study timer before archiving this module.');return}m.archived=!m.archived;toast(m.archived?'Module archived. Your history is preserved.':'Module restored.');render()}return}if(el.dataset.groupAction){let g=state.groups.find(x=>x.id===el.dataset.groupAction);if(!g)return;if(!g.joined){g.joined=true;g.members++;toast(`Joined ${g.name}!`);groupTab='my';render()}else{openModal(safe(g.name),'Collaborative study group overview',`<div class="summary-pair"><span>Module</span><strong>${safe(g.module)}</strong></div><div class="summary-pair"><span>Members</span><strong>${g.members}</strong></div><div class="summary-pair"><span>Your contribution</span><strong>${fmt(g.minutes)}</strong></div><div class="summary-pair"><span>Group status</span><strong>Active · ${safe(g.ends)}</strong></div><p class="panel-note">You can contribute by starting the study timer and selecting this group.</p><button class="btn" style="width:100%;margin-top:16px" id="studyThisGroup" data-id="${g.id}">${icon('play')} Study with this group</button>`)}return}switch(el.id){case 'startTimer':state.timer.running=true;state.timer.lastTick=Date.now();toast('Focus session started!');render();break;case 'pauseTimer':tick();state.timer.running=false;toast('Timer paused. Your progress is saved.');render();break;case 'saveTimer':{tick();let t=state.timer;let secs=t.mode==='stopwatch'?t.elapsed:(t.planned||1500)-t.remaining,mins=Math.max(1,Math.round(secs/60));if(secs<=0){toast('Study a little first, then save your session.');return}let m=state.modules.find(x=>x.id===t.module);if(!m){toast('Please select a module.');return}let g=state.groups.find(x=>x.id===t.group),date=new Date().toLocaleDateString('en-CA');m.minutes+=mins;if(g)g.minutes+=mins;state.history.unshift({id:'h'+Date.now(),date,module:m.code,minutes:mins,type:t.mode==='stopwatch'?'Stopwatch':'Countdown',group:g?.name||''});if(date==='2026-11-04')state.weekly[6]+=mins;state.timer={mode:t.mode,module:t.module,group:t.group,elapsed:0,remaining:t.planned||1500,planned:t.planned||1500,running:false,lastTick:0};toast(`${fmt(mins)} saved to ${m.code}${g?' and group':''}!`);render();break}case 'resetTimer':state.timer.running=false;state.timer.elapsed=0;state.timer.remaining=state.timer.planned||1500;toast('Timer reset.');render();break;case 'manualBtn':manualModal();break;case 'addModule':addModuleModal();break;case 'createGroup':createGroupModal();break;case 'editGoals':editGoalsModal();break;case 'closeModal':closeModal();break;case 'reset':if(confirm('Reset all sample changes to the original demo data?')){state=seed();groupTab='my';moduleTab='active';historyTab='all';section='dashboard';save();render();toast('Demo has been reset.')}break}}
document.addEventListener('click',handleClick);document.getElementById('modalBack').addEventListener('click',e=>{if(e.target.id==='modalBack')closeModal()});document.addEventListener('click',e=>{let el=e.target.closest('#studyThisGroup');if(el){state.timer.group=el.dataset.id;closeModal();go('study')}});
document.addEventListener('change',e=>{let t=state.timer;if(e.target.id==='timerModule'){t.module=e.target.value;save()}if(e.target.id==='timerGroup'){t.group=e.target.value;save()}if(e.target.id==='timerDuration'){let mins=Number(e.target.value);if(Number.isFinite(mins)&&mins>=1&&mins<=720&&!t.running){t.planned=Math.round(mins*60);t.remaining=t.planned;t.elapsed=0;render()}else toast('Enter between 1 and 720 minutes.')}});
document.addEventListener('submit',e=>{const f=e.target;if(!['manualForm','moduleForm','groupForm','goalForm'].includes(f.id))return;e.preventDefault();const d=Object.fromEntries(new FormData(f));if(f.id==='manualForm'){let mins=Number(d.hours)*60+Number(d.minutes),m=state.modules.find(x=>x.id===d.module);if(!m||!Number.isInteger(mins)||mins<=0||mins>1440||!d.date){toast('Enter a valid date and duration of 1–1440 minutes.');return}m.minutes+=mins;state.history.unshift({id:'h'+Date.now(),date:d.date,module:m.code,minutes:mins,type:'Manual',group:'',added:true});if(d.date==='2026-11-04')state.weekly[6]+=mins;toast(`${fmt(mins)} manually added to ${m.code}. Personal goals and streaks only.`)}if(f.id==='moduleForm'){let code=d.code.trim().toUpperCase(),name=d.name.trim();if(!code||!name)return;let period=[d.semester,d.year].filter(Boolean).join(' · ')||'No academic period';state.modules.push({id:'m'+Date.now(),code,name,period,minutes:0,color:'#6861ee',archived:false});moduleTab='active';toast(`${code} added to your modules.`)}if(f.id==='groupForm'){if(!d.name.trim())return;state.groups.unshift({id:'g'+Date.now(),name:d.name.trim(),module:d.module,members:1,ends:`Ends in ${Number(d.days)} days`,joined:true,minutes:0});groupTab='my';toast('Study group created!')}if(f.id==='goalForm'){state.goal=Number(d.goal);state.streakMin=Number(d.streak);if(state.goal<1||state.streakMin<1||state.goal>1440||state.streakMin>1440){toast('Enter positive goals of at most 1440 minutes.');return}toast('Goal settings updated in demo.')}closeModal();render()});
if(state.timer.running){let delta=Math.max(0,Math.floor((Date.now()-(state.timer.lastTick||Date.now()))/1000));if(delta>0){if(state.timer.mode==='stopwatch')state.timer.elapsed+=delta;else state.timer.remaining=Math.max(0,state.timer.remaining-delta);state.timer.lastTick=Date.now();if(state.timer.mode==='countdown'&&state.timer.remaining===0)state.timer.running=false}}if(!state.timer.planned)state.timer.planned=1500;if(state.timer.remaining===undefined)state.timer.remaining=1500;render();
</script></body></html>
